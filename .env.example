# Optional. When present, the website assistant uses an OpenAI-compatible model.
# Without a key it answers from the curated knowledge base in lib/assistant.ts.
OPENAI_API_KEY=

# OpenAI-compatible chat completions endpoint used by the assistant.
# Set this to the vetted provider's URL. The default is the existing proxy.
CHAT_API_URL=https://freebuff.com/api/v1/paid/chat/completions

# Must be one of the models allowlisted in app/api/chat/route.ts.
CHAT_MODEL=gpt-4o-mini

# Forms. Submissions are always written to .data/*.jsonl on the server.
# Set these to also deliver an email to the team (Resend HTTP API).
RESEND_API_KEY=
CONTACT_INBOX=info@kgoricapital.com
CONTACT_FROM="Kgori Capital website <website@kgoricapital.com>"

# Alternative delivery: forward every submission to a CRM or automation webhook.
CONTACT_WEBHOOK_URL=
